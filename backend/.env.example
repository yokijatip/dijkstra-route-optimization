# Set true after a Firebase project and Firestore database are configured.
FIREBASE_ENABLED=false

# Optional when the service-account file already contains project_id.
FIREBASE_PROJECT_ID=

# Recommended local-development method. Use an absolute path and keep the
# downloaded service-account JSON outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\username\Downloads\firebase-service-account.json

# Railway/other managed hosts: paste the complete one-line service-account JSON
# as a secret variable. Do not set this and GOOGLE_APPLICATION_CREDENTIALS together.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firestore collection used for experiment summaries and raw runs.
FIREBASE_EXPERIMENT_COLLECTION=experiments

# Comma-separated frontend origins for direct API access. Firebase Hosting's
# /api rewrite is same-origin and does not require an additional entry.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
